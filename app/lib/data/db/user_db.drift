-- user.db: the learner's own data, on the device only. Mirrors the user.db
-- half of replica/schema.sql. One deviation: exam_attempts.exam_set_number
-- instead of exam_set_id, because numbered sets are generated from a fixed
-- seed until content.db ships with an exam_sets table.
-- Times are unix milliseconds, UTC.

CREATE TABLE settings (
  "key"       TEXT NOT NULL PRIMARY KEY,
  value       TEXT NOT NULL,
  updated_at  INTEGER NOT NULL
);

CREATE TABLE question_progress (
  class_code       TEXT    NOT NULL,
  question_key     TEXT    NOT NULL,
  times_seen       INTEGER NOT NULL DEFAULT 0,
  times_wrong      INTEGER NOT NULL DEFAULT 0,
  last_correct     INTEGER CHECK (last_correct IN (0,1)),
  in_wrong_list    INTEGER NOT NULL DEFAULT 0 CHECK (in_wrong_list IN (0,1)),
  last_answered_at INTEGER,
  updated_at       INTEGER NOT NULL,
  PRIMARY KEY (class_code, question_key)
);
CREATE INDEX progress_wrong ON question_progress (class_code, last_answered_at) WHERE in_wrong_list = 1;

CREATE TABLE bookmarks (
  question_key TEXT NOT NULL PRIMARY KEY,
  created_at   INTEGER NOT NULL
);

CREATE TABLE topic_cursor (
  class_code  TEXT    NOT NULL,
  topic_id    INTEGER NOT NULL,
  position    INTEGER NOT NULL DEFAULT 0,
  updated_at  INTEGER NOT NULL,
  PRIMARY KEY (class_code, topic_id)
);

CREATE TABLE exam_attempts (
  id                 INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  class_code         TEXT    NOT NULL,
  exam_set_number    INTEGER,
  content_version    INTEGER NOT NULL,
  status             TEXT    NOT NULL DEFAULT 'in_progress'
                     CHECK (status IN ('in_progress','submitted','timed_out','abandoned')),
  started_at         INTEGER NOT NULL,
  deadline_at        INTEGER NOT NULL,
  finished_at        INTEGER,
  question_count     INTEGER NOT NULL,
  pass_mark          INTEGER NOT NULL,
  score              INTEGER,
  passed             INTEGER CHECK (passed IN (0,1)),
  failed_on_critical INTEGER CHECK (failed_on_critical IN (0,1)),
  CHECK (deadline_at > started_at),
  CHECK (status = 'in_progress' OR finished_at IS NOT NULL)
);
CREATE INDEX attempts_history ON exam_attempts (class_code, started_at DESC);
CREATE UNIQUE INDEX one_running_exam ON exam_attempts (status) WHERE status = 'in_progress';

CREATE TABLE attempt_answers (
  attempt_id      INTEGER NOT NULL REFERENCES exam_attempts(id) ON DELETE CASCADE,
  position        INTEGER NOT NULL,
  question_key    TEXT    NOT NULL,
  is_critical     INTEGER NOT NULL CHECK (is_critical IN (0,1)),
  chosen_position INTEGER CHECK (chosen_position BETWEEN 1 AND 4),
  is_correct      INTEGER CHECK (is_correct IN (0,1)),
  answered_at     INTEGER,
  PRIMARY KEY (attempt_id, position),
  UNIQUE (attempt_id, question_key)
);
